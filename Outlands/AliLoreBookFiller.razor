//Semi-Auto Lore Book Filler 
//By Ali
//This script will attempt to pull every lore page of the currently opened set in your tome
//If it gets the "You do not have any of that particular page" message in journal it will notify you and 
// return the pages to the tome. Its pretty quick so you can use this instead of scanning the numbers to check
//If its able to pull the entire set, it'll look for an empty lore book in your backpack and then fill it automatically
//If you dont have an empty lore book, it'll notify you and return the pages

//increase this if you are having any issues
@setvar! "latencyMS" 50 

//no edit
clearsysmsg

if not gumpexists 1274830955
    overhead "Open your lore tome to the page you'd like to assemble first" 32
    stop
endif
for 29
    if insysmsg "You do not have any of that particular page"
        gumpresponse 2 1274830955
        waitforgump 1274830955 50
        overhead "Incomplete set, returning pages" 32
        stop
    elseif "index" == 0  or "index" == 1 or "index" == 2 or "index" == 3 or "index" == 4 or "index" == 5 or "index" == 6 or "index" == 7 or "index" == 8 or "index" == 9 or "index" == 25 or "index" == 26 or "index" == 27 or "index" == 28
    elseif "index" == 20 or "index" == 21 or "index" == 22 or "index" == 23 or "index" == 24
        if ingump "Creatures of" 1274830955
            gumpresponse "index" 1274830955
            wait "latencyMS"
            waitforgump 1274830955 50
        endif
    else
        gumpresponse "index" 1274830955
        wait "latencyMS"
        waitforgump 1274830955 50
    endif
endfor

if findtype 29105 backpack 2897 as "loreBook"
    overhead "Assembling lore book" 1159
    dclick "loreBook"
    while findtype 27612 backpack 2910 as "lorePage"
        waitforgump 849262645 2000
        gumpresponse 2 849262645
        wait "latencyMS"
        wait "latencyMS"
        target "lorePage"
        wait "latencyMS"
        wait "latencyMS"
    endwhile
    waitforgump 849262645 2000
    gumpclose 849262645
else
    overhead "No lore book in backpack, returning pages" 1159
    gumpresponse 2 1274830955
    waitforgump 1274830955 50
endif