

@setvar "vendorBackpack"

removelist "countList"
createlist "countList"


if findtype 176 "vendorBackpack" as "distil"

endif


removelist "coordList"
createlist "coordList"

pushlist "coordList" x
pushlist "coordList" y



@clearignore
while findtype ITEMID FROMCONTAINER as "itemToMove"
    if ITEMSTRING
        getlabel "itemToMove" 'itemDesc'
        if ITEMSTRING in 'itemDesc'
        else
            @ignore "itemToMove"
            continue
        endif
    endif
    if poplist "coordList" "front" as x and poplist "coordList" "front" as y
        lift "itemToMove" QUANT
        drop TOCONTAINER x y
        wait 500
        promptresponse PRICE
        @ignore "itemToMove"
    endif
endwhile