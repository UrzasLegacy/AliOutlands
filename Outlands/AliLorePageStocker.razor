    elseif "page 14 of" in "desc"
        @setvar! "x" 146
    elseif "page 15 of" in "desc"
        @setvar! "x" 156
    endif
    #sysmsg "x"
    #sysmsg "y"
    #sysmsg "price"
    #sysmsg "containerID"
 
    lift "lorePage" 1
    drop "containerID" "x" "y" 0
    wait 325
    promptresponse "price"
    wait 325
    getlabel "lorePage" "tempDesc"
    if ": 40,000" in "tempDesc" and "creatures of" in "tempDesc"
    elseif ": 60,000" in "tempDesc"
    else
        lift "lorePage" 60000
        drop backpack 0 0 0
        wait 650
        lift "lorePage" 1
        drop "containerID" "x" "y" 0
        wait 325
        promptresponse "price"
        wait 325
        getlabel "lorePage" "tempDesc"
        if ": 40,000" in "tempDesc" and "creatures of" in "tempDesc"
        elseif ": 60,000" in "tempDesc"
        else
            lift "lorePage" 60000
            drop backpack 0 0 0
            wait 650
        endif
    endif
endwhile

@clearignore