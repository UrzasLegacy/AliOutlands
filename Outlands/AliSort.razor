// You dont have to follow the names, these are 
@setvar! harvestingContainer 0x4906A4F7
@setvar! magicContainer 0x4906A4F7
@setvar! EDCContainer 0x56C25228
@setvar! valuablesContainer 0x56C25228

@setvar! globalTimeout 650

# ---------------------------------------- #
# Ignore these things for sorting!

if findtype "spellbook" self 0 as mySpellBook
    @ignore mySpellBook
endif

if findtype 3922 self 0 as myDagger
    getlabel myDagger desc
    if "blessed" in desc
        @ignore myDagger
    endif
endif

# ---------------------------------------- #



while skill "mining" > 50 and findtype "forge" ground -1 -1 2 and findtype "iron ore" backpack as jore
        dclick jore
        wait 650
endwhile

while skill "lumberjacking" > 50 and findtype 7133 as logs
    if lhandempty ?? 0 
        if findtype "hatchet" backpack
            dclicktype 'hatchet' backpack
            wait 650
        endif
    endif
    if lhandempty ?? 0 
        overhead "No more hatchets!" 34
        break
    endif
    overhead 'Chopping Logs' 0
    hotkey 'Use item in hand'
    wft 500
    target logs
    wait 650
endwhile

while findtype 5132|5135|5075|5074|5061|7610|5070|5063|7175|7179|7169|7177|5090|5089|5076|7610|5085|5078|7170|7181|7177|5204|5207|5203|5201|5205|5078|7177|5101|5105|5103|5131|5106|5078|7177|7947|5060|5059|5103|5056|5106|5063|7177|5142|5146|5143|5138|5144|5139|7173|7177|10245|3740|3762|3763|3742|22187|3834|7034|7033|7027|7035|7026|7029|7031|7107|7109|5042|3920|5117|9917|3922|5121|5125|3719|5123|3938|5044|5181|3932|5179|5040|5127|3713|3568|5112|3721|5177|3934|5185|5119|3937|5046|5049|3913|3911|3915|3909|5115|5187|3917|5182 as item and findtype "ornate elven chest" ground any 1 2 as recycler
