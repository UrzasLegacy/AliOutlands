        break
    endif
    @ignore item
endwhile


# Tomes
if findtype 5356 backpack 0 and findtype 29104 ground 2990 1 2 as myTreasureMapBook
    overhead "Add to Tmap Book" 1159
    menu myTreasureMapBook 0
endif

if findtype 5356 backpack 2796 and findtype 29104 ground 2796 1 2 as myOreMapBook
    overhead "Add to Ore Book" 1159
    menu myOreMapBook 0
endif

if findtype 5356 backpack 2799 and findtype 29104 ground 2799 1 2 as myLumberMapBook
    overhead "Add to Lumber Book" 1159
    menu myLumberMapBook 0
endif

if findtype 5356 backpack 2651 and findtype 29104 ground 2651 1 2 as myHideMapBook
    overhead "Add to Hide Book" 1159
    menu myHideMapBook 0
endif

if findtype 5356 backpack 2904 and findtype 29104 ground 2904 1 2 as myFishMapBook
    overhead "Add to Fish Book" 1159
    menu myFishMapBook 0
endif

if findtype "scroll of calling" and findtype 29104 ground 2963 1 2 as myScrollBook
    overhead "Add to SS Book" 1159
    menu myScrollBook 0
endif

if findtype 5981 and findtype 29104 ground 1495 1 2 as myClothBook
    overhead "Add to Cloth Book" 1159
    menu myClothBook 0
endif

if findtype 3838|3839|3842|3843|15297|29025|29036|15296 and findtype 29104 ground 1494 1 2 as myDyeBook
    overhead "Add to Dye Book" 1159
    menu myDyeBook 0
endif

if findtype 27612 and findtype 29104 ground 2910 1 2 as myLorePageBook
    overhead "Add to Lore Book" 1159
    menu myLorePageBook 0
endif

if findtype 43206 and findtype 29104 ground 2091 1 2 as myLinkPageBook
    overhead "Add to Link Book" 1159
    menu myLinkPageBook 0
endif
    
if findtype 27611 and findtype 29104 ground 2141 1 2 as myCollectableCard
    overhead "Add to Collectible Card Book" 1159
    menu myCollectableCard 0
endif

wait 250

if findtype 'storage shelf' ground 0 1 2 as myStorageShelf
    overhead "Add to Storage Shelf" 1159
    menu myStorageShelf 0
    wft 1000
    target self
    waitforgump 3232825965
    gumpclose 
endif

if findtype 'resource container' ground 0 1 2 as myResourceContainer
    overhead "Add to Resource Container" 1159
    menu myResourceContainer 0
    wft 1000
    target self
endif

if findtype 'magic item chest' ground 0 1 2 as myMagicItemChest or findtype 'sm magic item vault' ground 0 1 2 as myMagicItemChest
    overhead "Add to Magic Item Chest" 1159
    menu myMagicItemChest 0
    wft 1000
    target self
endif

wait 500

#Valuables
